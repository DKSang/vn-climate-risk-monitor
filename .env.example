# Required local credentials. Copy this file to .env and replace every
# <...> placeholder before running Docker Compose. The file is gitignored.
POSTGRES_PASSWORD=<choose-a-local-postgres-password>
MINIO_ACCESS_KEY=<choose-a-local-minio-access-key>
MINIO_SECRET_KEY=<choose-a-local-minio-secret-key>
PGADMIN_DEFAULT_PASSWORD=<choose-a-local-pgadmin-password>
AIRFLOW_SECRET_KEY=<choose-a-local-airflow-secret-key>
AIRFLOW_FERNET_KEY=<generate-a-valid-airflow-fernet-key>
# ===== Open-Meteo =====
# Free API: không key, non-commercial, có attribution CC BY 4.0
# Loader params (batch size, lease, retry) nằm trong sources/*.yml
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
OPEN_METEO_FORECAST_MODEL=best_match
OPEN_METEO_FORECAST_HOURS=72
OPEN_METEO_LOCATION_BATCH_SIZE=25
# Model archive chọn theo THỜI KỲ, không phải biến môi trường: era5 trước 2017,
# ecmwf_ifs từ 2017 (xem open_meteo.py::model_for_month).
OPEN_METEO_FETCH_WORKERS=4

# ===== Storage / Lakehouse (MinIO) =====
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=vn-climate
MINIO_SECURE=false
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ===== PostgreSQL: ingestion control plane + DuckLake catalog =====
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=vnclimate
POSTGRES_USER=vnclimate

# ===== pgAdmin 4 (Postgres Web UI) =====
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@vnclimate.org

# ===== Serving =====
DASHBOARD_PORT=8501

# ── Lakehouse ──
DUCKLAKE_ALIAS=catalog1
DUCKLAKE_DATA_PATH=s3://vn-climate
DUCKLAKE_METADATA_SCHEMA=ducklake

# ===== Airflow =====
AIRFLOW_PORT=8080
AIRFLOW_DAGS_PAUSED_AT_CREATION=true

# ===== Alerting =====
# HTTP POST webhook khi pipeline fail hoặc health check degraded/unhealthy. Để trống = tắt alert.
ALERT_WEBHOOK_URL=
