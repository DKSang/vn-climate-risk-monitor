# Copy to .env và điền giá trị — KHÔNG commit .env
# ===== Open-Meteo =====
# Không cần key (API mở), chỉ đặt base URL
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive

# ===== Storage / Lakehouse (MinIO) =====
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=vn-climate
MINIO_SECURE=false

# ===== DuckLake catalog (Postgres) =====
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=vnclimate
POSTGRES_USER=vnclimate
POSTGRES_PASSWORD=vnclimate

# ===== pgAdmin 4 (Postgres Web UI) =====
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@vnclimate.org
PGADMIN_DEFAULT_PASSWORD=vnclimate

# ===== Airflow =====
AIRFLOW_HOME=/opt/airflow
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://vnclimate:vnclimate@postgres:5432/vnclimate

# ===== Serving =====
API_HOST=0.0.0.0
API_PORT=8000
DASHBOARD_PORT=8501

# ===== Alerting (ntfy — free push) =====
NTFY_TOPIC=vn-climate-risk