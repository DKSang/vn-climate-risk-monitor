# Copy to .env và điền giá trị — KHÔNG commit .env
# ===== Open-Meteo =====
# Free API: không key, non-commercial, có attribution CC BY 4.0
# Loader params (batch size, lease, retry) nằm trong sources/*.yml
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
OPEN_METEO_FORECAST_MODEL=best_match
OPEN_METEO_FORECAST_HOURS=72
OPEN_METEO_LOCATION_BATCH_SIZE=25
# Model archive chọn theo THỜI KỲ, không phải biến môi trường: era5 trước 2017,
# ecmwf_ifs từ 2017 (xem open_meteo.py::model_for_month).
OPEN_METEO_FETCH_WORKERS=4

# ===== Storage / Lakehouse (MinIO) =====
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=vn-climate
MINIO_SECURE=false

# ===== PostgreSQL: ingestion control plane + DuckLake catalog =====
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=vnclimate
POSTGRES_USER=vnclimate
POSTGRES_PASSWORD=vnclimate

# ===== pgAdmin 4 (Postgres Web UI) =====
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@vnclimate.org
PGADMIN_DEFAULT_PASSWORD=vnclimate

# ===== Serving =====
API_HOST=0.0.0.0
API_PORT=8000
DASHBOARD_PORT=8501

# ── Provero (kiểm tra chất lượng bronze, chạy sau `make load`) ──
DUCKLAKE_ALIAS=catalog1
DUCKLAKE_DATA_PATH=s3://vn-climate/bronze
DUCKLAKE_METADATA_SCHEMA=ducklake
