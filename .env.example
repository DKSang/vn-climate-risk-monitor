# Copy to .env và điền giá trị — KHÔNG commit .env
# ===== Open-Meteo =====
# Free API: không key, non-commercial, có attribution CC BY 4.0
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
OPEN_METEO_FORECAST_MODEL=best_match
OPEN_METEO_ARCHIVE_MODEL=era5_land
OPEN_METEO_FORECAST_HOURS=72
OPEN_METEO_LOCATION_BATCH_SIZE=25
OPEN_METEO_CONCURRENCY=1
OPEN_METEO_REQUEST_TIMEOUT_SECONDS=60
OPEN_METEO_MAX_ATTEMPTS=5
OPEN_METEO_MAX_EFFECTIVE_CALLS_PER_DAY=1000
OPEN_METEO_SCHEDULE_MINUTE_UTC=15
OPEN_METEO_COLLECTOR_STALE_AFTER_SECONDS=1800
OPEN_METEO_LOADER_BATCH_SIZE=10
OPEN_METEO_LOADER_LEASE_SECONDS=300
OPEN_METEO_LOADER_MAX_RETRIES=3
OPEN_METEO_MAX_LOAD_BATCHES=100
OPEN_METEO_STALE_AFTER_MINUTES=120

# ===== Storage / Lakehouse (MinIO) =====
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=vn-climate
MINIO_SECURE=false

# ===== PostgreSQL: ingestion control plane + DuckLake catalog =====
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=vnclimate
POSTGRES_USER=vnclimate
POSTGRES_PASSWORD=vnclimate

# ===== pgAdmin 4 (Postgres Web UI) =====
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@vnclimate.org
PGADMIN_DEFAULT_PASSWORD=vnclimate

# ===== Serving =====
API_HOST=0.0.0.0
API_PORT=8000
DASHBOARD_PORT=8501

# ===== Alerting (ntfy — free push) =====
NTFY_TOPIC=vn-climate-risk
