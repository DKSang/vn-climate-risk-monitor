# Local development credentials. Services are bound to 127.0.0.1.
# Change these values if other people can access your machine. Never commit .env.
POSTGRES_USER=vnclimate
POSTGRES_PASSWORD=postgres
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=admin

# ===== Open-Meteo =====
# Free API: no key, non-commercial, attribution CC BY 4.0
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
OPEN_METEO_FORECAST_MODEL=ecmwf_ifs
OPEN_METEO_FORECAST_HOURS=72
OPEN_METEO_LOCATION_BATCH_SIZE=25
OPEN_METEO_FETCH_WORKERS=4

# ===== Storage / Lakehouse (MinIO) =====
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=vn-climate
MINIO_SECURE=false
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ===== PostgreSQL =====
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=vnclimate

# ===== Serving =====
DASHBOARD_PORT=8501

# ===== Airflow =====
AIRFLOW_PORT=8080
AIRFLOW_DAGS_PAUSED_AT_CREATION=true

# ===== Alerting =====
# HTTP POST webhook on pipeline failure or unhealthy status. Empty disables it.
ALERT_WEBHOOK_URL=
