# Local development settings: copy to .env (never commit .env).
# Services bind to 127.0.0.1; change the credentials if others can reach this machine.

# Credentials (required)
POSTGRES_PASSWORD=postgres
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
AIRFLOW_PASSWORD=admin

# Postgres: DuckLake catalog, meta.* tables and Airflow metadata
POSTGRES_USER=vnclimate
POSTGRES_DB=vnclimate
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# MinIO: Bronze objects and DuckLake data files
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=vn-climate
MINIO_SECURE=false

# Open-Meteo (free, non-commercial, attribution CC BY 4.0)
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
OPEN_METEO_FORECAST_HOURS=72
OPEN_METEO_LOCATION_BATCH_SIZE=25

# Host ports published by docker compose (POSTGRES_PORT above is published too;
# keep MINIO_ENDPOINT's port equal to MINIO_API_PORT)
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
AIRFLOW_PORT=8080
DASHBOARD_PORT=8501

# Airflow
AIRFLOW_USERNAME=admin
AIRFLOW_DAGS_PAUSED_AT_CREATION=true
