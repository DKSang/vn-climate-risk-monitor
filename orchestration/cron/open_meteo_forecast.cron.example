# Dự báo Open-Meteo — chạy hằng giờ.
#
# Thay /path/to/vn-climate-risk-monitor bằng đường dẫn thật rồi cài bằng `crontab -e`.
# Lock file phải trùng với archive để hai job Open-Meteo không chạy đồng thời.
#
# forecast-pipeline chạy tuần tự fetch -> load forecast -> quality Bronze -> dbt
# build. Chuỗi dừng ngay ở bước lỗi; quality fail luôn chặn transform.

15 * * * * /usr/bin/flock -n /tmp/vn-climate-open-meteo.lock -c 'cd /path/to/vn-climate-risk-monitor && /usr/bin/env make forecast-pipeline' >> /path/to/vn-climate-risk-monitor/logs/open_meteo_forecast.log 2>&1
