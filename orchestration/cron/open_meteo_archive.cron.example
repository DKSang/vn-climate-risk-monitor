# Lịch sử Open-Meteo (ERA5 + ECMWF IFS) — bồi đuôi hằng ngày.
#
# Thay /path/to/vn-climate-risk-monitor bằng đường dẫn thật rồi cài bằng `crontab -e`.
# Dùng chung lock với forecast để hai job Open-Meteo không chạy đồng thời.

# Pipeline fetch và load cả hai nguồn, kiểm tra quality rồi refresh historical Gold.
# Loader tự bỏ qua nguồn không có file mới.
35 2 * * * /usr/bin/flock -n /tmp/vn-climate-open-meteo.lock -c 'cd /path/to/vn-climate-risk-monitor && /usr/bin/env make archive-pipeline START=$(date -d "-2 month" +\%Y-\%m-01) END=$(date +\%Y-\%m-01)' >> /path/to/vn-climate-risk-monitor/logs/open_meteo_archive.log 2>&1

# Backfill lịch sử chạy tay theo dải mong muốn:
#   make fetch-archive EXEC=1 START=2002-01-01 END=2002-12-01
#   make load SOURCE="open_meteo_archive open_meteo_ifs"
